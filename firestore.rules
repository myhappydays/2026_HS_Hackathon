rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // admins/{uid} 문서가 존재하는 계정만 관리자로 인정
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 관리자 목록: 본인 UID 문서 존재 여부(get)만 확인 가능.
    // 목록 조회(list)와 클라이언트 쓰기(write)는 전면 차단 — 콘솔에서만 관리.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // 제보(reports):
    // - 비로그인 방문자에게도 지도를 공개하려면 allow read: if true; 로 변경 가능
    // - 현재 정책은 로그인 사용자만 조회/작성 가능
    match /reports/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      // 작성자 본인 또는 관리자만 수정·삭제.
      // 그 외 로그인 사용자는 신고 횟수(reportCount)와 군집 배정(clusterId)만 갱신 가능.
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || (signedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'clusterId']));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    // 군집(clusters):
    // - 상태 전환(status, resolvedAt, resolvedBy)은 관리자만 변경 가능
    // - 군집 생성·병합·공감·댓글은 로그인 사용자 허용 (군집화가 브라우저에서 동작하므로)
    match /clusters/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (!('status' in request.resource.data) || request.resource.data.status == 'active')
        && !('resolvedAt' in request.resource.data)
        && !('resolvedBy' in request.resource.data);
      allow update: if isAdmin()
        || (signedIn()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'resolvedAt', 'resolvedBy']));
      // 빈 군집 정리(본인 마지막 제보 삭제 시) 또는 관리자 삭제
      allow delete: if isAdmin()
        || (signedIn()
            && (!('reportIds' in resource.data) || resource.data.reportIds.size() <= 1));
    }
  }
}
